{
  "name": "weekloom",
  "version": "0.1.4",
  "private": true,
  "description": "A local-first Gantt chart planner that runs as a desktop app. Your data never leaves your computer.",
  "license": "MIT",
  "main": "electron/dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:electron": "tsc -p tsconfig.electron.json",
    "prepare:standalone": "node scripts/prepare-standalone.mjs",
    "app:build": "npm run build && npm run build:electron && npm run prepare:standalone",
    "app:start": "npm run app:build && electron .",
    "package": "npm run app:build && electron-builder",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cuelume": "^0.1.0",
    "date-fns": "^4.2.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "next": "^16.3.0-canary.26",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.7",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0-canary.26",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
